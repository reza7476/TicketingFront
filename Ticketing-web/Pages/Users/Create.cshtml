@page
@model Ticketing_web.Pages.Users.CreateModel
@{
    ViewData["Title"] = "افزودن کاربر";
    Layout = "_Layout";
}

<div class="create-user-container" dir="rtl">

    <div class="create-user-header">
        <div>
            <h2>افزودن کاربر جدید</h2>
            <p>اطلاعات کاربر را وارد و ثبت کنید.</p>
        </div>

        <a asp-page="./Index" class="back-button">
            بازگشت به فهرست
        </a>
    </div>

    <div class="create-user-card">

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="message-box @(Model.IsSuccess ? "success" : "error")"
                 role="alert">
                @Model.Message
            </div>
        }

        <form method="post" class="create-user-form">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="Input.FirstName">نام</label>
                    <input asp-for="Input.FirstName"
                           placeholder="نام کاربر"
                           autocomplete="given-name" />
                    <span asp-validation-for="Input.FirstName"
                          class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.LastName">نام خانوادگی</label>
                    <input asp-for="Input.LastName"
                           placeholder="نام خانوادگی کاربر"
                           autocomplete="family-name" />
                    <span asp-validation-for="Input.LastName"
                          class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Mobile">شماره موبایل</label>
                    <input asp-for="Input.Mobile"
                           type="tel"
                           placeholder="09xxxxxxxxx"
                           dir="ltr"
                           autocomplete="tel" />
                    <span asp-validation-for="Input.Mobile"
                          class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.OrganizationId">سازمان</label>
                    <select asp-for="Input.OrganizationId"
                            asp-items="Model.Organizations">
                        <option value="">انتخاب سازمان</option>
                    </select>
                    <span asp-validation-for="Input.OrganizationId"
                          class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.RoleId">نقش</label>
                    <select asp-for="Input.RoleId"
                            asp-items="Model.Roles">
                        <option value="">انتخاب نقش</option>
                    </select>
                    <span asp-validation-for="Input.RoleId"
                          class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Password">رمز عبور</label>
                    <input asp-for="Input.Password"
                           type="password"
                           placeholder="رمز عبور را وارد کنید"
                           autocomplete="new-password" />
                    <span asp-validation-for="Input.Password"
                          class="field-error"></span>
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="submit-button">
                    ثبت کاربر
                </button>

                <a asp-page="./Index" class="cancel-button">
                    انصراف
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
