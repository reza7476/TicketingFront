@page
@model Ticketing_web.Pages.Agents.Tickets.IndexModel
@{
    ViewData["Title"] = "تیکت‌های ارجاع‌شده";
}


<div class="tickets-page" dir="rtl">

    <div class="page-header">
        <div>
            <h1>تیکت‌های ارجاع‌شده به پشتیبان</h1>
            <p>مدیریت و بررسی تیکت‌های ارجاع‌شده</p>
        </div>

        <div class="total-count">
            تعداد تیکت‌ها:
            <strong>@(Model.Tickets.Data.Count )</strong>
        </div>
    </div>

    <form method="get" class="filter-panel">

        <div class="filter-item">
            <label asp-for="AdminApproval">تأیید ادمین</label>
            <select asp-for="AdminApproval">
                <option value="">همه</option>
                <option value="true">تأیید شده</option>
                <option value="false">در انتظار تأیید</option>
            </select>
        </div>

        <div class="filter-item">
            <label asp-for="Priority">اولویت</label>
            <select asp-for="Priority"
                    asp-items="Html.GetEnumSelectList<Ticketing_web.EntityModels.Tickets.Priority>()">
                <option value="">همه اولویت‌ها</option>
            </select>
        </div>

        <div class="filter-item">
            <label asp-for="Status">وضعیت</label>
            <select asp-for="Status"
                    asp-items="Html.GetEnumSelectList<Ticketing_web.EntityModels.Tickets.TicketStatus>()">
                <option value="">همه وضعیت‌ها</option>
            </select>
        </div>

        <div class="filter-actions">
            <button type="submit" class="filter-button">
                اعمال فیلتر
            </button>

            <a asp-page="./Index" class="reset-button">
                پاک کردن فیلترها
            </a>
        </div>

    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="error-message">
            @Model.ErrorMessage
        </div>
    }

    <div class="table-panel">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>شماره</th>
                        <th>عنوان</th>
                        <th>کاربر سؤال‌کننده</th>
                        <th>اولویت</th>
                        <th>تاریخ ثبت تیکت</th>
                        <th>تاریخ ارجاع</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Tickets.Data is { Count: > 0 })
                    {
                        foreach (var ticket in Model.Tickets.Data)
                        {
                            <tr>
                                <td>@ticket.Number</td>

                                <td class="ticket-title">
                                    @ticket.Title
                                </td>

                                <td>@ticket.AskedBy</td>

                                <td>
                                    <span class="badge @Model.GetPriorityClass(ticket.Priority)">
                                        @ticket.Priority
                                    </span>
                                </td>

                                <td>
                                    @ticket.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                                </td>

                                <td>
                                    @ticket.AssignedAt.ToString("yyyy/MM/dd HH:mm")
                                </td>

                                <td>
                                    <span class="badge @Model.GetStatusClass(ticket.Status)">
                                        @ticket.Status
                                    </span>
                                </td>

                               

                                <td>
                                    <a asp-page="./Details"
                                       asp-route-id="@ticket.Id"
                                       class="details-button">
                                        جزئیات
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="empty-message">
                                تیکتی با این مشخصات پیدا نشد.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
