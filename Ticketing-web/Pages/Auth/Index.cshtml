@page
@model Ticketing_web.Pages.Auth.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "سامانه تیکتینگ";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>سامانه تیکتینگ | ورود و ثبت‌نام</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link href="~/css/login-page/login-page.css" rel="stylesheet" />
</head>
<body>
    <main class="auth-wrapper">
        <div class="auth-card">

            <!-- پنل معرفی سامانه -->
            <aside class="brand-panel">
                <div class="brand-content">
                    <div class="brand-logo">
                        <div class="logo-icon">🎫</div>
                        <span>Ticketing</span>
                    </div>

                    <h1>به سامانه تیکتینگ خوش آمدید</h1>

                    <p class="brand-description">
                        درخواست‌های خود را ثبت کنید،
                        پاسخ‌ها را دریافت کنید و وضعیت تیکت‌های خود را
                        به‌راحتی پیگیری کنید.
                    </p>

                    <div class="ticket-illustration">🎟️</div>

                    <div class="brand-features">
                        <div>
                            <div class="feature-icon">🛡️</div>
                            <div class="feature-title">امن و مطمئن</div>
                            <div class="feature-description">
                                حفاظت از اطلاعات
                            </div>
                        </div>

                        <div>
                            <div class="feature-icon">⚡</div>
                            <div class="feature-title">پاسخ‌گویی سریع</div>
                            <div class="feature-description">
                                پیگیری آسان درخواست‌ها
                            </div>
                        </div>

                        <div>
                            <div class="feature-icon">🎧</div>
                            <div class="feature-title">پشتیبانی</div>
                            <div class="feature-description">
                                همراه شما در هر مرحله
                            </div>
                        </div>
                    </div>
                </div>

                <div class="brand-footer">
                    سامانه مدیریت و پیگیری درخواست‌ها
                </div>
            </aside>

            <!-- پنل ورود و ثبت‌نام -->
            <section class="form-panel">

                <div class="auth-tabs">
                    <button type="button"
                            class="auth-tab active"
                            data-target="login">
                        ورود به حساب
                    </button>

                    <button type="button"
                            class="auth-tab"
                            data-target="register">
                        ایجاد حساب
                    </button>
                </div>

                <!-- فرم ورود -->
                <form id="login" class="auth-form active" asp-page-handler="login">
                    <h2 class="form-heading">ورود به سامانه</h2>
                    @Html.AntiForgeryToken()
                    <p class="form-subtitle">
                        برای ورود، اطلاعات حساب کاربری خود را وارد کنید.
                    </p>

                    <div class="field-group">
                        <label class="field-label" for="loginEmail">
                            موبایل
                        </label>
                        <input id="loginEmail"
                               name="mobile"
                               type="text"
                               class="form-control"
                               placeholder="989121234578"
                               autocomplete="mobile"
                               required>
                    </div>

                    <div class="field-group">
                        <label class="field-label" for="loginPassword">
                            رمز عبور
                        </label>
                        <input id="loginPassword"
                               name="Password"
                               type="password"
                               class="form-control"
                               placeholder="رمز عبور خود را وارد کنید"
                               autocomplete="current-password"
                               required>
                    </div>
                    <div id="loginMessage" class="text-danger mt-2"></div>
                    <button type="submit" class="btn btn-auth">
                        ورود به حساب
                    </button>
                </form>

               
            </section>
        </div>
    </main>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script>

        $(() => {

            $("#login").on("submit", function (event) {

                event.preventDefault();
                const formData = $(this).serialize();
                $.ajax({
                    url: $(this).attr("action"),
                    type: "POST",
                    data: formData,
                    success: function (res) {
                        console.log(res)

                        if (res.success) {
                            window.location.href = "/Dashboard"
                        } else {
                            $("#loginMessage").text(res.message || "ورود ناموفق بود");
                        }
                    },
                    error: function (xhr) {
                        $("#loginMessage").text(
                            xhr.responseJSON?.message
                            || "ارسال اطلاعات با خطا مواجه شد."
                        );
                    }
                });
            });
        })
    </script>
</body>
</html>