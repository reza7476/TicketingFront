@page "{id}"
@using Ticketing_web.EntityModels.Tickets
@model Ticketing_web.Pages.Clients.Tickets.DetailsModel

@{
    ViewData["Title"] = "جزئیات تیکت";
    Layout = "_Layout";
}
@{
    var canEditTicket = false;
    if (Model.Ticket is not null)
    {
        canEditTicket = Model.Ticket.Status == TicketStatus.Open
                        && !Model.Ticket.Replies.Any();
    }
    var canEditReply = false;
    if(Model.Ticket is not null)
    {
        canEditReply = Model.Ticket.Status == TicketStatus.Open;
    }

    
    var lastClientReplyId = Model.Ticket?.Replies
        .Where(r => r.IssuedBy == "Client")
        .OrderByDescending(r => r.CreatedAt)
        .Select(r => r.Id)
        .FirstOrDefault();

}
@if (Model.Ticket is not null)
{
    var statusClass = Model.Ticket.Status switch
    {
        TicketStatus.Open => "status-open",
        TicketStatus.InProgress => "status-in-progress",
        TicketStatus.Answered => "status-answered",
        TicketStatus.Closed => "status-closed",
        _ => "status-unknown"
    };

    var priorityClass = Model.Ticket.Priority switch
    {
        Priority.Low => "priority-low",
        Priority.Medium => "priority-medium",
        Priority.High => "priority-high",
        _ => "priority-unknown"
    };

    <div class="ticket-details-page">
        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert-message alert-success">
                @Model.Message
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert-message alert-error">
                @Model.ErrorMessage
            </div>
        }
        <header class="page-header">
            <h1>@Model.Ticket.Title</h1>
            <a asp-page="./Index">بازگشت</a>
        </header>

        <main class="ticket-main">

            <!-- اطلاعات تیکت -->
            <section class="ticket-information">

                <h2>اطلاعات تیکت</h2>

                <div class="ticket-information-grid">

                    <div class="ticket-field">
                        <span>عنوان تیکت</span>
                        <p>@Model.Ticket.Title</p>
                    </div>

                    <div class="ticket-field">
                        <span>وضعیت تیکت</span>
                        <p class="@statusClass">@Model.Ticket.Status</p>
                    </div>

                    <div class="ticket-field">
                        <span>تاریخ ثبت</span>
                        <p>@Model.Ticket.CreatedAt.ToString("yyyy/MM/dd HH:mm")</p>
                    </div>

                    <div class="ticket-field">
                        <span>توسط</span>
                        <p>@Model.Ticket.AskedBy</p>
                    </div>

                    <div class="ticket-field">
                        <span>اولویت</span>
                        <p class="@priorityClass">@Model.Ticket.Priority</p>
                    </div>

                    <div class="ticket-field ticket-content">
                        <span>متن تیکت</span>
                        <p>@Model.Ticket.Content</p>
                    </div>

                </div>

                <!-- فایل های پیوست تیکت -->
                @if (Model.Ticket.Documents.Any())
                {
                 
                    <div class="ticket-documents">

                        <h3>فایل‌های پیوست</h3>

                        @foreach (var document in Model.Ticket.Documents)
                        {
                            var downloadUrl =
                            $"https://api-ticketing.rdehghani.ir/api/storages/{document.DocumentId}/download";

                            var isImage = document.Extension.StartsWith(
                            "image/",
                            StringComparison.OrdinalIgnoreCase
                            );

                            <div class="document-item">

                                @if (isImage)
                                {
                                    <img src="@downloadUrl"
                                         alt="تصویر پیوست" />
                                }
                                else
                                {
                                    <div class="file-placeholder">
                                        <span>📄</span>
                                        <p>فایل پیوست</p>
                                    </div>
                                }

                                <a href="@downloadUrl" target="_blank">
                                    دانلود فایل
                                </a>
                            </div>

                            @if (canEditTicket)
                            {
                                <form method="post"
                                      asp-page-handler="DeleteTicketDocument"
                                      class="delete-document-form">
                                    <input type="hidden" name="documentId" value="@document.DocumentId" />
                                    <input type="hidden" name="id" value="@Model.Id" />

                                    <button type="submit" class="delete-attachment-button" title="حذف فایل">
                                        ×
                                    </button>
                                </form>
                            }

                        }
                    </div>
                }
                @if (canEditTicket==true)
                {
                    <form method="post" 
                        enctype="multipart/form-data"
                        asp-page-handler="SendFile"> 

                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="file-upload">
                        
                            <label>فایل پیوست</label>
                            <input type="file"
                                   id="add-ticket-File"
                                   asp-for="Document"
                                   class="file-upload-input" />
                        
                            <label class="file-upload-box"
                                   for="add-ticket-File">
                                <span>📎</span>
                                <span>برای انتخاب فایل یا تصویر کلیک کنید</span>
                            </label>
                        
                            <div class="file-upload-preview">
                        
                                <img class="file-upload-image"
                                     src=""
                                     alt="پیش‌نمایش" />
                        
                                <span class="file-upload-name"></span>
                        
                                <button type="button"
                                        class="file-upload-remove">
                                    حذف فایل
                                </button>
                                <button type="submit" class="save-button">
                                    افزودن فایل
                                </button>
                            </div>
                        
                        </div>
                    </form>
                }

            </section>

       
           <!-- ویرایش تیکت -->
            @if (canEditTicket)
             {
                <section class="ticket-edit-section">
            
                     <button type="button"
                             id="show-ticket-edit"
                             class="edit-ticket-button">
                         <span>✏️</span>
                         ویرایش تیکت
                     </button>
            
                     <div id="ticket-edit-container" style="display:none;">
            
                         <form method="post"
                               asp-page-handler="EditTicket"
                               enctype="multipart/form-data"
                               class="ticket-edit-form">
            
                             <input type="hidden"
                                    name="id"
                                    value="@Model.Id" />
            
                             <h2>ویرایش تیکت</h2>
            
                             <div class="form-group">
                                 <label for="Title">عنوان تیکت</label>
                                 <input type="text"
                                        id="Title"
                                        name="Title"
                                        value="@Model.Ticket.Title" />
                             </div>
            
                             <div class="form-group">
                                 <label for="Content">متن تیکت</label>
                                 <textarea id="Content"
                                           name="Content"
                                           rows="5">@Model.Ticket.Content</textarea>
                             </div>
            
                             <div class="form-group">
                                 <label for="Priority">اولویت</label>
                                 <select id="Priority" name="Priority">
                                     @foreach (var priority in Enum.GetValues<Priority>())
                                     {
                                         <option value="@priority"
                                                 selected="@(Model.Ticket.Priority == priority)">
                                             @priority
                                         </option>
                                     }
                                 </select>
                             </div>
                             <div class="edit-form-actions">
                                 <button type="submit" class="save-button">
                                     ذخیره تغییرات
                                 </button>
            
                                 <button type="button"
                                         id="cancel-ticket-edit"
                                         class="cancel-button">
                                     انصراف
                                 </button>
                             </div>
            
                         </form>
            
                     </div>
            
                 </section>
            }

            <!-- گفتگوها -->
            <section class="conversation">

                <h2>گفتگوها</h2>

                <div class="chat-container">

                    @foreach (var reply in Model.Ticket.Replies)
                    {
                        var isMine = reply.IssuedBy == "Client";

                        <div class="message-row @(isMine ? "mine" : "other")">

                            <div class="message-bubble">

                                <div class="message-text">
                                    @reply.Content
                                </div>

                                <!-- فایل های پیوست پاسخ -->
                                @if (reply.Documents.Any())
                                {
                                    <div class="reply-document">

                                        @foreach (var document in reply.Documents)
                                        {
                                            var downloadUrl =
                                            $"https://api-ticketing.rdehghani.ir/api/storages/{document.DocumentId}/download";

                                            var isImage = document.Extension.StartsWith(
                                            "image/",
                                            StringComparison.OrdinalIgnoreCase);

                                            <div class="reply-document-item">

                                                @if (isImage)
                                                {
                                                    <a href="@downloadUrl" target="_blank">

                                                        <img src="@downloadUrl"
                                                             alt="تصویر پیوست"
                                                             class="reply-document-image" />

                                                    </a>
                                                }
                                                else
                                                {
                                                    <div class="reply-file-placeholder">
                                                        📄 <span>فایل پیوست</span>
                                                    </div>
                                                }
                                                <a href="@downloadUrl" target="_blank">
                                                    دانلود فایل
                                                </a>
                                                @if (canEditReply && reply.Id == lastClientReplyId)
                                                {
                                                    <form method="post"
                                                          asp-page-handler="DeleteTicketReplyDocument"
                                                          class="delete-document-form">
                                                        <input type="hidden" name="documentId" value="@document.DocumentId" />
                                                        <input type="hidden" name="id" value="@Model.Id" />

                                                        <button type="submit" class="delete-attachment-button" title="حذف فایل">
                                                            ×
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        }

                                    </div>

                                 
                                }

                                <div class="message-footer">

                                    <span class="message-role">
                                        @reply.IssuedBy
                                    </span>

                                    <span class="message-time">
                                        @reply.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                                    </span>

                                </div>

                                @if (canEditReply && reply.IssuedBy == "Client" && reply.Id == lastClientReplyId)
                                {
                                    <div class="reply-edit-section">

                                        <button type="button"
                                                class="edit-reply-button">
                                            <span>✏️</span>
                                            ویرایش پاسخ
                                        </button>

                                        <div class="reply-edit-container" style="display:none;">

                                            <form method="post" 
                                                  enctype="multipart/form-data"
                                                  asp-page-handler="EditReply">

                                                <input type="hidden"
                                                       name="ReplyId"
                                                       value="@reply.Id" />

                                                <div class="form-group">

                                                    <label asp-for="ReplyContent">
                                                        متن پاسخ
                                                    </label>

                                                    <textarea name="EditedReplyContent"
                                                              placeholder="متن پاسخ خود را ویرایش کنید"
                                                              rows="4">@reply.Content</textarea>

                                                </div>
                                                <div class="file-upload">

                                                    <label>افزودن فایل پیوست</label>

                                                    <input type="file"
                                                           id="reply-edit-file-@reply.Id"
                                                           asp-for="Document"
                                                           class="file-upload-input" />

                                                    <label for="reply-edit-file-@reply.Id"
                                                           class="file-upload-box">

                                                        <span>📎</span>
                                                        <span>برای انتخاب فایل یا تصویر کلیک کنید</span>

                                                    </label>

                                                    <div class="file-upload-preview">

                                                        <img class="file-upload-image"
                                                             src=""
                                                             alt="پیش‌نمایش" />

                                                        <span class="file-upload-name"></span>

                                                        <button type="button"
                                                                class="file-upload-remove">
                                                            حذف فایل
                                                        </button>

                                                    </div>

                                                </div>

                                                <div class="reply-edit-actions">

                                                    <button type="submit" class="save-button">
                                                        ذخیره تغییرات
                                                    </button>

                                                    <button type="button" class="cancel-reply-edit">
                                                        انصراف
                                                    </button>

                                                </div>

                                            </form>

                                        </div>

                                    </div>
                                }
                        </div>
                        </div>

                    }

                </div>

            </section>

            <!-- فرم ثبت پاسخ -->
            @if (Model.Ticket.Status == TicketStatus.Answered)
            {
                <section class="reply-form">

                    <h2>ارسال پاسخ</h2>

                    <form method="post"
                          enctype="multipart/form-data"
                          asp-page-handler="Reply">

                        <div class="form-group">

                            <label asp-for="ReplyContent">
                                متن پاسخ
                            </label>

                            <textarea asp-for="ReplyContent"
                                      placeholder="پاسخ خود را بنویسید"
                                      rows="5"></textarea>

                        </div>

                           <div class="file-upload">

                            <label>فایل پیوست</label>

                            <input type="file"
                                   id="replyFile"
                                   asp-for="Document"
                                   class="file-upload-input" />

                            <label for="replyFile"
                                   class="file-upload-box">

                                <span>📎</span>
                                <span>برای انتخاب فایل یا تصویر کلیک کنید</span>

                            </label>

                            <div class="file-upload-preview">

                                <img class="file-upload-image"
                                     src=""
                                     alt="پیش‌نمایش" />

                                <span class="file-upload-name"></span>

                                <button type="button"
                                        class="file-upload-remove">
                                    حذف فایل
                                </button>
                                <button type="submit">
                                    ارسال پاسخ
                                </button>
                            </div>

                        </div>
                    </form>
                        <!-- انتخاب فایل پاسخ -->
                       
                        

                </section>
            }

        </main>

    </div>
}

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        $(() => {

            // انتخاب فایل و نمایش پیش نمایش
            $(".file-upload-input").on("change", function () {

                const file = this.files[0];

                const container = $(this).closest(".file-upload");

                const preview = container.find(".file-upload-preview");
                const image = container.find(".file-upload-image");
                const fileName = container.find(".file-upload-name");

                if (!file) {
                    preview.hide();
                    return;
                }

                fileName.text(file.name);

                if (file.type.startsWith("image/")) {

                    const reader = new FileReader();

                    reader.onload = function (e) {

                        image.attr("src", e.target.result).show();

                    };

                    reader.readAsDataURL(file);

                }
                else {

                    image.attr("src", "").hide();

                }

                preview.css("display", "flex");

            });


            // حذف فایل انتخاب شده
            $(".file-upload-remove").on("click", function () {

                const container = $(this).closest(".file-upload");

                container.find(".file-upload-input").val("");

                container.find(".file-upload-image")
                    .attr("src", "")
                    .hide();

                container.find(".file-upload-name").text("");

                container.find(".file-upload-preview").hide();

            });
            
            // نمایش فرم ویرایش تیکت
            $("#show-ticket-edit").on("click", function () {
                $("#ticket-edit-container").slideDown(250);
                $(this).hide();
            });

         
            // بستن فرم ویرایش
            $("#cancel-ticket-edit").on("click", function () {
                $("#ticket-edit-container").slideUp(250);
                $("#show-ticket-edit").show();
            });





            $(".edit-reply-button").on("click",function(){
                const section = $(this).closest(".reply-edit-section");
                section.find(".reply-edit-container").slideDown(250);
                $(this).hide();
            })


            $(".cancel-reply-edit").on("click",function(){
                const section = $(this).closest(".reply-edit-section");
                section.find(".reply-edit-container").slideUp(250);
                section.find(".edit-reply-button").show();
            })

        });
    </script>
}
