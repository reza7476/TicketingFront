@page
@model Ticketing_web.Pages.Organizations.IndexModel
@{
    Layout = "_Layout";
}

<div class="organizations-page" dir="rtl">

    <div class="page-header">
        <div>
            <h2>مدیریت ارگان‌ها</h2>
            <p>فهرست ارگان‌های ثبت‌شده در سامانه</p>
        </div>

        <a asp-page="./Create" class="add-organization-btn">
            <span class="plus-icon">+</span>
            افزودن ارگان
        </a>
    </div>

    <div class="organizations-card">

        <form method="get" class="filter-form">

            <div class="search-box">
                <label for="Search">جست‌وجوی نام ارگان</label>

                <div class="search-input-wrapper">
                    <span class="search-icon">⌕</span>

                    <input type="text"
                           id="searchName"
                           name="search"
                           value="@Model.Search"
                           placeholder="نام ارگان را وارد کنید..." />
                </div>
            </div>

            
            <div class="filter-actions">
                <button type="submit" class="filter-btn">
                    جست‌وجو  
                </button>

                <a asp-page="./Index" class="reset-btn">
                    پاک کردن
                </a>
            </div>

        </form>

        <div class="table-header">
            <h4>فهرست ارگان‌ها</h4>
            <span class="records-count">
                تعداد: @Model.Organizations.Count
            </span>
        </div>

        <div class="table-responsive">
            <table class="organizations-table">
                <thead>
                    <tr>
                        <th>ردیف</th>
                        <th>نام ارگان</th>
                        <th>شماره  شناسه</th>
                        <th>پیش فرض</th>
                        <th>عملیات</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Organizations!=null)
                    {
                        var rowNumber = 1;

                        @foreach (var item in Model.Organizations)
                        {
                            <tr>
                                <td>@rowNumber</td>

                                <td class="organization-name">
                                    @item.Name
                                </td>

                                <td class="organization-name">
                                    @item.OrganizationCode
                                </td>
                                <td>
                                    @if (item.IsDefault)
                                    {
                                        <span class="status-badge active">
                                            پیش فرض
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inactive">
                                           
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="table-actions">
                                        <a asp-page="./Edit"
                                           asp-route-id="@item.Id"
                                           class="action-btn edit-btn">
                                            ویرایش
                                        </a>
                                    </div>
                                </td>
                            </tr>

                            rowNumber++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="empty-state">
                                <div class="empty-icon">📂</div>
                                <p>ارگانی برای نمایش پیدا نشد.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>
